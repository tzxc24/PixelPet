CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=y
CONFIG_PIXELPET_BOOT_NETWORK=y
CONFIG_PIXELPET_NETWORK_AUDIO_CONFIRMED=y
CONFIG_PIXELPET_SERIAL_VOICE_CONTROL=y
CONFIG_PIXELPET_NETWORK_AUDIO_GAIN_PERCENT=100
CONFIG_PIXELPET_USE_ESP_SR_VAD=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=20
