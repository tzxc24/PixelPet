LLM_PROVIDER=deepseek
# Paste your own key locally; never commit it or put it in browser code.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_THINKING=disabled
LLM_TIMEOUT=60
# auto: real provider when key exists, otherwise Mock. mock: force offline rules.
LLM_MODE=auto
# Generic OpenAI-compatible provider uses LLM_PROVIDER=openai and this key.
LLM_API_KEY=
PIXELPET_DATABASE_PATH=output/pixelpet.sqlite3
# Local speech model files live under tmp/models, not in the cloud.
PIXELPET_ASR_MODEL=base
PIXELPET_ASR_MODEL_DOWNLOAD=false
PIXELPET_SPEECH_TIMEOUT=120
# Lexical relevance stays primary. 0 disables importance decay; days is a half-weight scale.
PIXELPET_MEMORY_DECAY_DAYS=90
# For explicit LAN use, add only this PC's actual LAN IP and set a separate token.
PIXELPET_ALLOWED_HOSTS=localhost,127.0.0.1,::1
PIXELPET_ACCESS_TOKEN=

# Optional Baidu ASR. Select it in settings after configuring credentials.
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
BAIDU_ASR_TIMEOUT=20
BAIDU_ASR_DEV_PID=1537

# All saved conversation history is sent without truncation; this is a character safety cap, not the model token limit.
LLM_HISTORY_MAX_CHARS=500000
